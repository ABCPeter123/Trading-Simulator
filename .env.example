# Trading Simulator local AI provider. Copy to git-ignored .env.
# Recommended: two local GGUF models through llama.cpp router (port 8081).
# Download model weights separately to ignored models/private/.
TRADING_SIM_AI_PROVIDER=llama_cpp
TRADING_SIM_AI_MODEL=TwIL-8B-Q4_K_M-balanced.gguf
TRADING_SIM_AI_MODELS=TwIL-8B-Q4_K_M-balanced.gguf,Qwen3.5-9B-Q4_K_M.gguf
TRADING_SIM_AI_TIMEOUT_SECONDS=600
# Lower this from 8192 to reduce excessively long reasoning and response time.
# For TwIL requests requiring longer reasoning, use 8192 explicitly.
TRADING_SIM_AI_MAX_OUTPUT_TOKENS=4096

# Local llama.cpp inference tuning. No paid API and no forced disk cache.
# Profiles: speed (4096 context), balanced (6144), quality (8192).
TRADING_SIM_LLAMA_PROFILE=speed
# Physical CPU cores selected automatically, or set explicit values:
# TRADING_SIM_LLAMA_THREADS=8
# TRADING_SIM_LLAMA_THREADS_BATCH=12
# GPU offload needs a llama.cpp build with CUDA or another supported backend.
TRADING_SIM_LLAMA_GPU_LAYERS=auto
# Optional per-device overrides:
# TRADING_SIM_LLAMA_CONTEXT=6144
# TRADING_SIM_LLAMA_BATCH=1024
# TRADING_SIM_LLAMA_UBATCH=256

# To keep using legacy Ollama instead:
# TRADING_SIM_AI_PROVIDER=ollama
# TRADING_SIM_AI_MODEL=llama3.2

# To use OpenAI instead:
# TRADING_SIM_AI_PROVIDER=openai
# TRADING_SIM_AI_MODEL=gpt-6-luna
# OPENAI_API_KEY=put-your-own-api-key-here
#
# The Python backend loads these settings from .env at startup.
# Restart the backend after changes.
# Never commit a real API key or enter it in the browser chat.

# Optional private live strategy notification settings (add only to .env).
# Never commit actual webhooks, recipient information or passwords.
# TRADING_SIM_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# TRADING_SIM_SMTP_HOST=smtp.example.com
# TRADING_SIM_SMTP_PORT=465
# TRADING_SIM_SMTP_USER=your-smtp-user
# TRADING_SIM_SMTP_PASSWORD=your-private-app-password
# TRADING_SIM_EMAIL_FROM=your-sender@example.com
# TRADING_SIM_EMAIL_TO=your-recipient@example.com
#
# These settings are read by start-live-machine.ps1, not Vercel.

# Optional iMessage via your own Apple Messages Mac + BlueBubbles server.
# Requires a Mac signed into Messages. Windows cannot originate iMessage itself.
# All values are placeholders and stay ONLY in this locally ignored .env file.
# TRADING_SIM_IMESSAGE_SERVER_URL=https://your-own-mac-relay.example
# TRADING_SIM_IMESSAGE_PASSWORD=your-bluebubbles-server-password
# TRADING_SIM_IMESSAGE_CHAT_GUID=iMessage;-;recipient@example.com
# TRADING_SIM_IMESSAGE_INCLUDE_DETAILS=0
# Default 0 sends generic review notices without tickers, positions or strategy data.
# Set to 1 only if you explicitly want alert details in Apple Messages.
# The live machine must be restarted to load changes. Never commit real values.

# Comprehensive email briefing, handled by the private Windows live worker.
# Configure only your ignored local .env, never put your real addresses here.
# Requires authenticated SMTP. Gmail: enable 2-Step Verification and create an
# app password (NOT your normal Gmail account password).
# TRADING_SIM_NOTIFICATION_CHANNELS=email
# TRADING_SIM_SMTP_HOST=smtp.gmail.com
# TRADING_SIM_SMTP_PORT=465
# TRADING_SIM_SMTP_USER=your-sending-account@gmail.com
# TRADING_SIM_SMTP_PASSWORD=your-gmail-app-password
# TRADING_SIM_EMAIL_FROM=your-sending-account@gmail.com
# TRADING_SIM_EMAIL_TO=recipient-one@example.com,recipient-two@example.com
# TRADING_SIM_EMAIL_DIGEST_ENABLED=1
# TRADING_SIM_EMAIL_DIGEST_TIME=17:15
# Weekdays at 5:15 PM America/Toronto; new signals / open risk alerts send
# immediately in the live worker. Details include trading signals, positions,
# realized P/L, risk, activity, execution reviews and machine health.
# Email leaves your computer and is not end-to-end encrypted by this project.
