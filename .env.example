# Trading Simulator AI provider. Copy this file to .env (the file is git-ignored).
# Default: a LOCAL Ollama installation. No API key and no cloud data transfer.
TRADING_SIM_AI_PROVIDER=ollama
TRADING_SIM_AI_MODEL=llama3.2
# Optional stronger English/Chinese local research (requires RAM):
# First run: ollama pull qwen2.5:7b
# Then set TRADING_SIM_AI_MODEL=qwen2.5:7b and restart the backend
# Local Ollama model response timeout, between 60 and 600 seconds
TRADING_SIM_AI_TIMEOUT_SECONDS=240

# To use OpenAI instead:
# TRADING_SIM_AI_PROVIDER=openai
# TRADING_SIM_AI_MODEL=gpt-6-luna
# OPENAI_API_KEY=put-your-own-api-key-here
#
# The Python backend loads these settings from .env at startup.
# Restart the backend after changes.
# Never commit a real API key or enter it in the browser chat.

# Optional private live strategy notification settings (add only to .env).
# Never commit actual webhooks, recipient information or passwords.
# TRADING_SIM_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# TRADING_SIM_SMTP_HOST=smtp.example.com
# TRADING_SIM_SMTP_PORT=465
# TRADING_SIM_SMTP_USER=your-smtp-user
# TRADING_SIM_SMTP_PASSWORD=your-private-app-password
# TRADING_SIM_EMAIL_FROM=your-sender@example.com
# TRADING_SIM_EMAIL_TO=your-recipient@example.com
#
# These settings are read by start-live-machine.ps1, not Vercel.
